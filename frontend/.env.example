
# Leave empty to use the Vite /api development proxy.
# Set a full API origin only when the frontend directly calls a separately
# hosted backend, and configure FRONTEND_ORIGINS on that backend accordingly.
VITE_API_BASE_URL=
# Optional: change the development proxy target (default http://127.0.0.1:8000).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
