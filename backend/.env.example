# Database used by the backend. Use a local development database, never a
# production database for local testing.
DB_USER=local_user
DB_PASSWORD=replace-with-local-database-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mindbridge_local

APP_ENV=development
SESSION_COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Optional comma-separated exact institutional domains. Every entry must end
# in .edu.in. Leave blank to accept syntactically valid addresses on any
# .edu.in domain. COLLEGE_EMAIL_DOMAIN remains supported for one domain.
COLLEGE_EMAIL_DOMAINS=

# Generate a unique random value of at least 32 characters for each deployment.
OTP_HASH_SECRET=replace-with-random-secret-at-least-32-characters
OTP_EXPIRATION_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=5
OTP_MAX_ATTEMPTS=5
COORDINATOR_INVITATION_EXPIRATION_HOURS=72

# SMTP provider or local email catcher (e.g. MailHog). Never put live values
# in source control. SMTP_USE_TLS=true enables STARTTLS.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=mindbridge@example.invalid
SMTP_USE_TLS=false
